    )


async def transfer_command(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    amount=None,
):

    if not update.message:
        return

    if not update.message.reply_to_message:
        await update.message.reply_text(
            "❌ برای انتقال باید روی پیام کاربر موردنظر Reply کنی.\n\n"
            "مثال:\n"
            "انتقال 60"
        )
        return

    if amount is None:
        await update.message.reply_text(
            "❌ مقدار سکه را مشخص کن.\n\n"
            "مثال:\n"
            "انتقال 60"
        )
        return

    if amount <= 0:
        await update.message.reply_text(
            "❌ مقدار باید بیشتر از صفر باشد."
        )
        return

    sender = update.effective_user
    receiver = (
        update.message.reply_to_message
        .from_user
    )

    if sender.id == receiver.id:
        await update.message.reply_text(
            "❌ نمی‌توانی به خودت سکه انتقال بدهی."
        )
        return

    sender_name = sender.first_name or "کاربر"
    receiver_name = receiver.first_name or "کاربر"

    if sender.id != OWNER_ID:

        if not remove_coins(
            sender.id,
            amount,
            sender_name,
        ):
            await update.message.reply_text(
                "❌ سکه کافی نداری."
            )
            return

    add_coins(
        receiver.id,
        amount,
        receiver_name,
    )

    await update.message.reply_text(
        "✅ انتقال انجام شد!\n\n"
        f"👤 گیرنده: {receiver_name}\n"
        f"🪙 مقدار انتقال: {amount} سکه"
    )


