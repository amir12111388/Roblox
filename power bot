async def message_handler(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):

    if not update.message:
        return

    text = update.message.text.strip()

    # استخراج
    if text in MINE_WORDS:
        await mine_command(
            update,
            context,
        )
        return

    # موجودی
    if text in {
        "موجودی",
        "موجودی من",
    }:
        await balance_command(
            update,
            context,
        )
        return

    # بازی‌ها
    if text in {
        "بازی‌ها",
        "بازی ها",
    }:
        await games_command(
            update,
            context,
        )
        return

    # چپ
    if text == "چپ":
        await left_right(
            update,
            context,
            "چپ",
        )
        return

    # راست
    if text == "راست":
        await left_right(
            update,
            context,
            "راست",
        )
        return

    # تبدیل
    if text.startswith("تبدیل"):

        parts = text.split()

        if len(parts) == 1:
            await convert_command(
                update,
                context,
            )
            return

        try:
            amount = int(parts[1])
        except ValueError:
            await update.message.reply_text(
                "❌ مقدار را به صورت عدد وارد کن.\n\n"
                "مثال:\n"
                "تبدیل 150"
            )
            return

        await convert_command(
            update,
            context,
            amount,
        )

        return

    # انتقال
    if text.startswith("انتقال"):

        parts = text.split()

        if len(parts) == 1:
            await transfer_command(
                update,
                context,
            )
            return

        try:
            amount = int(parts[1])
        except ValueError:
            await update.message.reply_text(
                "❌ مقدار را به صورت عدد وارد کن.\n\n"
                "مثال:\n"
                "انتقال 60"
            )
            return

        await transfer_command(
            update,
            context,
            amount,
        )

        return

    # راهنما
    if text == "راهنما":

        await update.message.reply_text(
            "📖 راهنمای Power Bot\n\n"
            "⛏ استخراج الماس\n"
            "⛏ استخراج\n"
            "⛏ استر\n"
            "⛏ استخر\n\n"
            "💎 موجودی\n"
            "🎮 بازی‌ها\n"
            "🔄 تبدیل 150\n"
            "💰 انتقال 60\n\n"
            "↔️ برای بازی چپ و راست بنویس:\n"
            "چپ\n"
            "یا\n"
            "راست"
        )

        return


