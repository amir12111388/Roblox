        "هر ۱ الماس = ۱۰ سکه است.\n\n"
        "برای مثال اگر ۱۵۰ الماس داشته باشی، "
        "می‌توانی ۱۵۰ الماس را به ۱۵۰۰ سکه تبدیل کنی.\n\n"
        "برای تبدیل بنویس:\n"
        "تبدیل 150"
    )


async def convert_command(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
    amount=None,
):

    user = update.effective_user

    if amount is None:
        await update.message.reply_text(
            "🔄 مقدار الماسی که می‌خواهی تبدیل کنی را بنویس.\n\n"
            "مثال:\n"
            "تبدیل 150"
        )
        return

    if amount <= 0:
        await update.message.reply_text(
            "❌ مقدار باید بیشتر از صفر باشد."
        )
        return

    if user.id == OWNER_ID:
        await update.message.reply_text(
            f"🔄 {amount} الماس تبدیل شد.\n"
            f"🪙 سکه دریافتی: {amount * DIAMOND_TO_COIN}"
        )
        return

    name = user.first_name or "کاربر"

    diamonds = get_diamonds(
        user.id,
        name,
    )

    if diamonds < amount:
        await update.message.reply_text(
            "❌ الماس کافی نداری."
        )
        return

    data["users"][str(user.id)]["diamonds"] -= amount

    data["users"][str(user.id)]["coins"] += (
        amount * DIAMOND_TO_COIN
    )

    save_data()

    await update.message.reply_text(
        "✅ تبدیل انجام شد!\n\n"
        f"💎 الماس مصرف شده: {amount}\n"
        f"🪙 سکه دریافت شده: "
        f"{amount * DIAMOND_TO_COIN}\n\n"
        f"💎 الماس باقی‌مانده: "
        f"{data['users'][str(user.id)]['diamonds']}\n"
        f"🪙 سکه فعلی: "
        f"{data['users'][str(user.id)]['coins']}"
    )


