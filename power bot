        result = (
            "🎉 درست حدس زدی!\n\n"
            f"🤖 انتخاب من: {correct}\n"
            f"🪙 جایزه: {amount} سکه"
        )

    else:

        result = (
            "😄 این بار اشتباه شد!\n\n"
            f"🤖 انتخاب من: {correct}\n"
            "نگران نباش، دوباره امتحان کن."
        )

    await update.message.reply_text(
        result
