# =========================================================
# استخراج
# =========================================================

MINE_WORDS = {
    "استخراج",
    "استخراج الماس",
    "استر",
    "استخر",
}


def mining_key(user_id, chat_id):
    return f"{user_id}:{chat_id}"


def get_remaining(user_id, chat_id):

    key = mining_key(
        user_id,
        chat_id,
    )

    if key not in data["mining"]:
        return 0

    last = data["mining"][key]

    remaining = MINING_COOLDOWN - (
        time.time() - last
    )

    if remaining <= 0:
        return 0

    return int(remaining) + 1


def format_remaining(seconds):

    minutes = seconds // 60
    seconds = seconds % 60

    if minutes:
        return (
            f"{minutes} دقیقه و "
            f"{seconds} ثانیه"
        )

    return f"{seconds} ثانیه"


async def mine_command(
    update: Update,
    context: ContextTypes.DEFAULT_TYPE,
):

    user = update.effective_user
    chat = update.effective_chat

    if not user or not chat:
        return

    remaining = get_remaining(
        user.id,
        chat.id,
    )

    if remaining > 0:

        await update.message.reply_text(
            "⛏ کارگران معدن مشغول کار هستند! 😂\n\n"
            f"⏳ {format_remaining(remaining)} "
            "دیگه می‌تونی دوباره استخراج کنی."
        )

        return

    amount = random.randint(
        1,
        100,
    )

    add_diamonds(
        user.id,
        amount,
        user.first_name or "کاربر",
    )

    key = mining_key(
        user.id,
        chat.id,
    )

    data["mining"][key] = time.time()

    save_data()

    diamonds = get_diamonds(
        user.id,
        user.first_name or "کاربر",
    )

    await update.message.reply_text(
        "⛏ استخراج موفق بود!\n\n"
        f"💎 الماس دریافت شده: {amount}\n"
        f"💎 موجودی الماس: {diamonds}\n\n"
        "⏳ استخراج بعدی: ۳ دقیقه دیگر"
    )


