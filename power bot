OWNER_ID = 7860500580

DATA_FILE = "power_bot_data.json"

MINING_COOLDOWN = 180

DIAMOND_TO_COIN = 10

data = {
    "users": {},
    "mining": {},
}


# =========================================================
# ذخیره اطلاعات
# =========================================================

def load_data():
    global data

    if not os.path.exists(DATA_FILE):
        return

    try:
        with open(DATA_FILE, "r", encoding="utf-8") as file:
            loaded = json.load(file)

        data["users"] = loaded.get("users", {})
        data["mining"] = loaded.get("mining", {})

    except Exception:
        data = {
            "users": {},
            "mining": {},
        }


def save_data():
    try:
        with open(DATA_FILE, "w", encoding="utf-8") as file:
            json.dump(
                data,
                file,
                ensure_ascii=False,
                indent=2,
            )
    except Exception as error:
        print("خطا در ذخیره اطلاعات:", error)


