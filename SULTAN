local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local root = character:WaitForChild("HumanoidRootPart")

local isGhost = false
local isLocked = false
local originalCFrame = nil
local ghostParts = {}

-- تابع برای فعال/غیرفعال کردن حالت روح
local function toggleGhostMode()
    isGhost = not isGhost
    
    if isGhost then
        originalCFrame = root.CFrame
        root.Anchored = true
        root.Velocity = Vector3.new(0, 0, 0)
        
        for _, part in pairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                table.insert(ghostParts, part)
                part.CanCollide = false
            end
        end
        humanoid.Sit = false
    else
        root.Anchored = false
        for _, part in ipairs(ghostParts) do
            part.CanCollide = true
        end
        ghostParts = {} 
        
        if originalCFrame then
            root.CFrame = originalCFrame
            originalCFrame = nil
        end
        humanoid.Sit = false 
    end
end

-- تابع برای تلپورت Abuse
local function teleportAbuse()
    local currentCFrame = root.CFrame
    local targetCFrame = root.CFrame * CFrame.new(0, -1000, 0)
    
    if root.Anchored then
        root.Anchored = false
    end
    
    root.CFrame = targetCFrame
    
    task.delay(3, function()
        if not isGhost then
            root.CFrame = currentCFrame
        end
    end)
end

